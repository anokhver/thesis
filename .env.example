# Copy to .env and adjust. .env is read by docker-compose via env_file.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Thesis text link surfaced in the UI
THESIS_PDF_URL=https://example.com/anokhina-bachelor-thesis.pdf

# Background-job runner
# Swap to the real ML pipeline entry point once it's merged.
ANALYSIS_WORK_FN=synapse_web.services.work_stub.do_work
# 1 = run jobs inline (tests / debugging); 0 = use the thread pool
ANALYSIS_JOBS_SYNC=0
# Stale-run sweep threshold (minutes); used by recover_stale_runs
ANALYSIS_STALE_AFTER_MINUTES=60

# ML pipeline I/O. All optional; defaults live under MEDIA_ROOT.
# Override CHECKPOINT_DIR to point at a shared folder of .pt files.
# CHECKPOINT_DIR=/srv/synapseg/checkpoints
# RUNS_DIR=/srv/synapseg/runs
# MAX_CHECKPOINT_UPLOAD_BYTES=524288000
