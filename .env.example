# Copy to .env and adjust. .env is read by docker-compose via env_file.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Thesis text link surfaced in the UI
THESIS_PDF_URL=https://example.com/anokhina-bachelor-thesis.pdf

# Background-job runner
# Default points at the real ML pipeline. Override to work_stub.do_work
# for fast in-process debugging without torch.
ANALYSIS_WORK_FN=synapse_web.services.ml_jobs.do_work
# 1 = run jobs inline (tests / debugging); 0 = use the thread pool
ANALYSIS_JOBS_SYNC=0
# Stale-run sweep threshold (minutes); used by recover_stale_runs
ANALYSIS_STALE_AFTER_MINUTES=60

# Storage paths. All optional; defaults live inside the project tree so
# a fresh checkout works without any configuration. Override to point at
# an external disk (e.g. a lab share) without rebuilding the image — the
# Docker volumes in docker-compose.yml will then bind those external
# paths instead of the in-image defaults.
# SCE_MEDIA_ROOT=/mnt/lab_share/synapseg/media
# SCE_CHECKPOINT_DIR=/mnt/lab_share/synapseg/checkpoints
# SCE_RUNS_DIR=/mnt/lab_share/synapseg/runs
# SCE_SQLITE_PATH=/mnt/lab_share/synapseg/db.sqlite3

# Upload limits
# SCE_MAX_CHECKPOINT_UPLOAD_BYTES=524288000
# SCE_MAX_ZIP_UPLOAD_BYTES=2147483648
# SCE_MAX_ZIP_UNCOMPRESSED_BYTES=21474836480
# SCE_MAX_ZIP_MEMBERS=200000
